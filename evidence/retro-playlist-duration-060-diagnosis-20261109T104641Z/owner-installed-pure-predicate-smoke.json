  "durationCoreSource": "def duration_rows_only(songs, playlist_name):\n    total_ms = 0\n    for song in songs:\n        if song.playlist_name != playlist_name:\n            return False\n        total_ms += song.duration_ms\n    return float(45 * 60 * 1000 <= total_ms <= 50 * 60 * 1000)",
